{
  "name": "@oxy/tokens",
  "version": "0.0.0",
  "description": "Primitive, semantic and component design tokens for Oxy UI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ProjectOxy/oxy.git",
    "directory": "packages/tokens"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./component.stylex": "./src/component.stylex.ts",
    "./primitives": "./src/primitives.ts",
    "./semantic.stylex": "./src/semantic.stylex.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./component.stylex": "./dist/component.stylex.js",
      "./primitives": "./dist/primitives.js",
      "./semantic.stylex": "./dist/semantic.stylex.js",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "generate": "node scripts/generate.ts",
    "build": "node scripts/generate.ts && vp pack"
  },
  "devDependencies": {
    "@stylexjs/stylex": "catalog:",
    "jsdom": "^30.1.1"
  },
  "peerDependencies": {
    "@stylexjs/stylex": "catalog:"
  }
}
