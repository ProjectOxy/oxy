{
  "name": "@oxy/utilities",
  "version": "0.0.0",
  "description": "Token-driven utility class layer for Oxy UI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ProjectOxy/oxy.git",
    "directory": "packages/utilities"
  },
  "bin": {
    "oxy-utilities": "./src/cli.ts"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./vite": "./src/vite.ts",
    "./package.json": "./package.json",
    "./utilities.css": "./dist/utilities.css"
  },
  "publishConfig": {
    "bin": {
      "oxy-utilities": "./dist/cli.js"
    },
    "exports": {
      ".": "./dist/index.js",
      "./vite": "./dist/vite.js",
      "./package.json": "./package.json",
      "./utilities.css": "./dist/utilities.css"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack"
  },
  "dependencies": {
    "@oxy/tokens": "workspace:*"
  },
  "devDependencies": {
    "@stylexjs/stylex": "catalog:",
    "@stylexjs/unplugin": "catalog:",
    "@vitest/browser-playwright": "4.1.11",
    "playwright": "1.63.0"
  }
}
